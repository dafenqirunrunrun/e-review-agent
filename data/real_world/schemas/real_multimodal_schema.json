{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E-Review Agent Real Multimodal Review Record",
  "type": "object",
  "required": [
    "sample_id",
    "source_id",
    "source_record_id_hash",
    "source_language",
    "product_category",
    "rating",
    "review_text",
    "image_available",
    "image_ids",
    "risk_type",
    "secondary_risk_types",
    "risk_level",
    "need_human_review",
    "text_evidence_spans",
    "visual_evidence_labels",
    "text_image_consistency",
    "expected_action",
    "ambiguity_flag",
    "annotator_confidence",
    "annotation_status",
    "privacy_status",
    "source_type",
    "split"
  ],
  "additionalProperties": false,
  "properties": {
    "sample_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_record_id_hash": {"type": "string"},
    "source_language": {"enum": ["zh", "en", "other"]},
    "product_category": {"type": "string"},
    "rating": {"type": ["integer", "number", "null"], "minimum": 1, "maximum": 5},
    "review_text": {"type": "string"},
    "image_available": {"type": "boolean"},
    "image_ids": {"type": "array", "items": {"type": "string"}},
    "risk_type": {"type": "string"},
    "secondary_risk_types": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "need_human_review": {"type": "boolean"},
    "text_evidence_spans": {"type": "array"},
    "visual_evidence_labels": {"type": "array"},
    "text_image_consistency": {"enum": ["consistent", "conflicting", "unrelated", "uncertain"]},
    "expected_action": {"type": "string"},
    "ambiguity_flag": {"type": "boolean"},
    "annotator_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "annotation_status": {"enum": ["unlabeled", "labeled", "adjudicated"]},
    "privacy_status": {"enum": ["cleared", "redacted", "rejected", "uncertain"]},
    "source_type": {"enum": ["real_public", "real_authorized"]},
    "split": {"enum": ["development", "validation", "external_test"]}
  }
}
