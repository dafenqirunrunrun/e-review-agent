# E-Review Agent final delivery environment example.
# Copy values into your local shell or service manager as needed.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=litemall
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Service ports
AI_SERVICE_PORT=8008
WX_API_PORT=8080
ADMIN_API_PORT=8083
LITEMALL_VUE_PORT=6255
LITEMALL_ADMIN_PORT=9527

# AI Agent framework
AGENT_FRAMEWORK_ENABLED=true
AGENT_FRAMEWORK_PROVIDER=langgraph
AGENT_FRAMEWORK_FALLBACK_ENABLED=true
AGENT_FRAMEWORK_REQUIRE_API_KEY=false

# Optional only. Leave empty for rule/mock tool execution.
OPENAI_API_KEY=

# Agent-RAG governed local runtime. Model paths stay outside Git.
AGENT_RAG_TARGET_MODE=enterprise-maturity-local-single-node
RAG_DENSE_PROVIDER=bge-m3
RAG_BGE_M3_PROVIDER_IMPL=flagembedding
RAG_DEFAULT_RETRIEVAL_MODE=bm25-first-semantic-hybrid
RAG_RERANKER_TYPE=deterministic
RAG_RERANKER_MODEL_PATH=
RAG_RERANKER_MODEL_NAME=
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_TIMEOUT_MS=5000
RAG_RERANKER_MAX_CONCURRENCY=1
RAG_RERANKER_QUEUE_TIMEOUT_MS=1000
RAG_REAL_RERANKER_REQUIRED=false
RAG_PII_REDACTION_ENABLED=true
RAG_PROMPT_INJECTION_GUARD_ENABLED=true
RAG_PROMPT_INJECTION_ACTION=manual-review
RAG_AUDIT_RETENTION_DAYS=30
RAG_SECURE_EXPORT_ENABLED=true
AGENT_LLM_PROVIDER=rule
RAG_RULE_FALLBACK_ENABLED=true
RAG_EVIDENCE_ENABLED=true
RAG_REAL_DENSE_REQUIRED=false

# Agentic review workflow with optional structure-aware public policy RAG.
E_REVIEW_AGENTIC_WORKFLOW_ENABLED=true
E_REVIEW_AGENTIC_MAX_ITERATIONS=2
E_REVIEW_AGENTIC_INTENT_ROUTER_PROVIDER=rule
E_REVIEW_AGENTIC_INTENT_ROUTER_MODEL=Qwen/Qwen2.5-0.5B-Instruct
E_REVIEW_AGENTIC_INTENT_ROUTER_TIMEOUT_MS=3000
E_REVIEW_AGENTIC_ROUTER_RULE_ENHANCEMENTS_ENABLED=true
E_REVIEW_HIGH_RISK_SAFETY_GATE_ENABLED=true
# Step 21.4: decision-only shadow observation. Keep disabled until the frozen policy artifact is deployed.
E_REVIEW_FAST_ELIGIBILITY_SHADOW_ENABLED=false
E_REVIEW_FAST_ELIGIBILITY_SHADOW_POLICY_PATH=artifacts/step213h_fast_eligibility_gate/fast_eligibility_policy_v1.json
E_REVIEW_FAST_ELIGIBILITY_SHADOW_OUTPUT_DIR=artifacts/step214_fast_eligibility_shadow
E_REVIEW_FAST_ELIGIBILITY_SHADOW_REPORT_PATH=../docs/FAST_ELIGIBILITY_SHADOW_REPORT.md
# Step 21.5: controlled activation. Disable this single switch to restore the baseline chain.
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_ENABLED=false
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_CANARY_PERCENT=100
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_POLICY_PATH=artifacts/step213h_fast_eligibility_gate/fast_eligibility_policy_v1.json

# Step 18: sampled, non-persisted strict audit for low-touch reviews.
AI_GOVERNANCE_QUALITY_SHADOW_SAMPLE_PERCENT=5
E_REVIEW_HUMAN_REVIEW_ENABLED=true
E_REVIEW_POLICY_EVIDENCE_DISPLAY_ENABLED=true
E_REVIEW_POLICY_RAG_ENABLED=true
E_REVIEW_POLICY_RAG_INDEX_PATH=data/policy_rag_real/index/policy_chunks.jsonl
E_REVIEW_POLICY_RAG_STRICT_INDEX=false
E_REVIEW_POLICY_RAG_DENSE_ENABLED=true
E_REVIEW_POLICY_RAG_DENSE_RETRIEVAL_ENABLED=true
E_REVIEW_POLICY_RAG_BM25_FALLBACK_ENABLED=true
E_REVIEW_POLICY_RAG_TOP_K=3
E_REVIEW_POLICY_RAG_EMBEDDING_PROVIDER=qwen
E_REVIEW_POLICY_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
E_REVIEW_POLICY_RAG_EMBEDDING_MODEL_PATH=
E_REVIEW_POLICY_RAG_EMBEDDING_IMPL=transformers
E_REVIEW_POLICY_RAG_EMBEDDING_DEVICE=cpu
E_REVIEW_POLICY_RAG_EMBEDDING_BATCH_SIZE=4
E_REVIEW_POLICY_RAG_EMBEDDING_MAX_LENGTH=96
E_REVIEW_POLICY_RAG_EMBEDDING_ALLOW_REMOTE=false
E_REVIEW_POLICY_RAG_CPU_THREADS=0
E_REVIEW_POLICY_RAG_WARMUP_ENABLED=false
E_REVIEW_POLICY_RAG_VECTOR_STORE=faiss
E_REVIEW_POLICY_RAG_RERANKER_ENABLED=false
E_REVIEW_POLICY_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
E_REVIEW_POLICY_RAG_RERANKER_MODEL_PATH=<your-local-reranker-path>
E_REVIEW_POLICY_RAG_RERANKER_DEVICE=cpu
E_REVIEW_POLICY_RAG_RERANKER_BATCH_SIZE=5
E_REVIEW_POLICY_RAG_RERANKER_CANDIDATE_K=5
E_REVIEW_POLICY_RAG_RERANKER_FINAL_K=3
E_REVIEW_POLICY_RAG_RERANKER_LATENCY_BUDGET_MS=2500
E_REVIEW_POLICY_RAG_RERANKER_MAX_CONCURRENCY=1
E_REVIEW_POLICY_RAG_RERANKER_QUEUE_TIMEOUT_MS=1000
E_REVIEW_POLICY_RAG_RERANKER_WARMUP_ENABLED=false
MINERU_CLI=mineru
MINERU_OUTPUT_DIR=
MINERU_TIMEOUT_SECONDS=120
