<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.linlinjava.litemall.db.dao.LitemallAiGovernanceObservationMapper">
  <resultMap id="BaseResultMap" type="org.linlinjava.litemall.db.domain.LitemallAiGovernanceObservation">
    <id column="id" property="id"/><result column="event_type" property="eventType"/><result column="analysis_id" property="analysisId"/><result column="risk_task_id" property="riskTaskId"/><result column="review_id" property="reviewId"/><result column="route" property="route"/><result column="decision" property="decision"/><result column="evidence_status" property="evidenceStatus"/><result column="retrieval_mode" property="retrievalMode"/><result column="risk_types_json" property="riskTypesJson"/><result column="workflow_version" property="workflowVersion"/><result column="governance_schema_version" property="governanceSchemaVersion"/><result column="policy_index_version" property="policyIndexVersion"/><result column="embedding_model" property="embeddingModel"/><result column="latency_ms" property="latencyMs"/><result column="human_decision" property="humanDecision"/><result column="human_reason_code" property="humanReasonCode"/><result column="audit_result" property="auditResult"/><result column="shadow_decision" property="shadowDecision"/><result column="shadow_disagreement" property="shadowDisagreement"/><result column="evidence_refs" property="evidenceRefs"/><result column="created_time" property="createdTime"/>
  </resultMap>
  <insert id="insertSelective" parameterType="org.linlinjava.litemall.db.domain.LitemallAiGovernanceObservation" useGeneratedKeys="true" keyProperty="id">
    insert into litemall_ai_governance_observation (event_type,analysis_id,risk_task_id,review_id,route,decision,evidence_status,retrieval_mode,risk_types_json,workflow_version,governance_schema_version,policy_index_version,embedding_model,latency_ms,human_decision,human_reason_code,audit_result,shadow_decision,shadow_disagreement,evidence_refs,created_time)
    values (#{eventType},#{analysisId},#{riskTaskId},#{reviewId},#{route},#{decision},#{evidenceStatus},#{retrievalMode},#{riskTypesJson},#{workflowVersion},#{governanceSchemaVersion},#{policyIndexVersion},#{embeddingModel},#{latencyMs},#{humanDecision},#{humanReasonCode},#{auditResult},#{shadowDecision},#{shadowDisagreement},#{evidenceRefs},#{createdTime})
  </insert>
  <select id="querySince" resultMap="BaseResultMap">select * from litemall_ai_governance_observation where created_time &gt;= #{since} order by created_time desc</select>
  <select id="queryPendingQa" resultMap="BaseResultMap">select * from litemall_ai_governance_observation where event_type='decision' and decision='auto_pass' and audit_result is null order by created_time desc limit #{limit}</select>
  <update id="updateAuditResult">update litemall_ai_governance_observation set audit_result=#{auditResult} where id=#{id} and event_type='decision' and audit_result is null</update>
</mapper>
