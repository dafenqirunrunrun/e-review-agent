# Select qwen, deepseek, or local_rule_fallback. Keep secrets in a local environment only.
E_REVIEW_LLM_PROVIDER=local_rule_fallback
E_REVIEW_LLM_TIMEOUT_SECONDS=30
E_REVIEW_LLM_MAX_RETRIES=2

E_REVIEW_QWEN_ENABLED=true
E_REVIEW_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
E_REVIEW_QWEN_MODEL=qwen-plus
E_REVIEW_QWEN_API_KEY=

E_REVIEW_DEEPSEEK_ENABLED=true
E_REVIEW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
E_REVIEW_DEEPSEEK_MODEL=deepseek-chat
E_REVIEW_DEEPSEEK_API_KEY=

# Optional local Qwen3 provider. Keep model weights outside the Git repository.
E_REVIEW_LOCAL_QWEN_ENABLED=true
E_REVIEW_LOCAL_QWEN_MODEL=Qwen/Qwen3-1.7B
E_REVIEW_LOCAL_QWEN_MODEL_DIR=
E_REVIEW_LOCAL_QWEN_DEVICE=auto
E_REVIEW_LOCAL_QWEN_TORCH_DTYPE=auto
E_REVIEW_LOCAL_QWEN_MAX_NEW_TOKENS=512
E_REVIEW_LOCAL_QWEN_ENABLE_THINKING=false
E_REVIEW_LOCAL_QWEN_TIMEOUT_SECONDS=120

# Optional local vLLM/SGLang/LM Studio OpenAI-compatible endpoint.
E_REVIEW_LOCAL_QWEN_BASE_URL=http://127.0.0.1:8009/v1
E_REVIEW_LOCAL_QWEN_MODEL_NAME=Qwen/Qwen3-1.7B

# v1.6 Hybrid RAG. Model weights and FAISS build dependencies remain local.
E_REVIEW_RAG_V2_ENABLED=false
E_REVIEW_RAG_V2_STRATEGY=hybrid_rerank
E_REVIEW_RAG_TOP_K=5
E_REVIEW_RAG_CANDIDATE_K=20
E_REVIEW_RAG_ALPHA=0.30
E_REVIEW_RAG_BETA=0.40
E_REVIEW_RAG_GAMMA=0.20
E_REVIEW_RAG_DELTA=0.10

E_REVIEW_EMBEDDING_PROVIDER=bge_m3
E_REVIEW_BGE_M3_MODEL_DIR=
E_REVIEW_EMBEDDING_DEVICE=cuda
E_REVIEW_EMBEDDING_BATCH_SIZE=16
E_REVIEW_EMBEDDING_NORMALIZE=true
E_REVIEW_EMBEDDING_MAX_LENGTH=512

E_REVIEW_RERANKER_PROVIDER=neural
E_REVIEW_RERANKER_MODEL=BAAI/bge-reranker-base
E_REVIEW_RERANKER_MODEL_DIR=
E_REVIEW_RERANKER_DEVICE=cuda
E_REVIEW_RERANKER_BATCH_SIZE=8

# v2.0 Agent-RAG Phase 1 governed runtime. Example values only.
AGENT_RAG_ENABLED=true
AGENT_RAG_TARGET_MODE=enterprise-maturity-local-single-node
AGENT_RAG_RUNTIME_MODE=local-model
RAG_TOP_K=8
RAG_RERANK_TOP_K=4
RAG_MIN_SCORE=0.0
RAG_PUBLIC_TENANT_ENABLED=true
RAG_MODEL_TIMEOUT_SECONDS=30
RAG_MAX_REPAIR_ATTEMPTS=1
RAG_RULE_FALLBACK_ENABLED=true
RAG_EVIDENCE_ENABLED=true
RAG_SPARSE_ENABLED=true
RAG_DENSE_ENABLED=true
RAG_HYBRID_ENABLED=true
RAG_SPARSE_TOP_K=12
RAG_DENSE_TOP_K=12
RAG_FUSION_TOP_K=8
RAG_RRF_K=60
RAG_RERANKER_TYPE=deterministic
RAG_RERANKER_TOP_K=5
RAG_RERANKER_MODEL_PATH=
RAG_RERANKER_MODEL_NAME=
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_USE_FP16=false
RAG_RERANKER_BATCH_SIZE=4
RAG_RERANKER_MAX_LENGTH=512
RAG_RERANKER_CANDIDATE_K=20
RAG_RERANKER_FINAL_K=5
RAG_RERANKER_TIMEOUT_MS=5000
RAG_RERANKER_MAX_CONCURRENCY=1
RAG_RERANKER_QUEUE_TIMEOUT_MS=1000
RAG_RERANKER_FALLBACK_TYPE=deterministic
RAG_REAL_RERANKER_REQUIRED=false
RAG_MIN_EVIDENCE_SCORE=0.0
RAG_PII_REDACTION_ENABLED=true
RAG_PROMPT_INJECTION_GUARD_ENABLED=true
RAG_PROMPT_INJECTION_ACTION=manual-review
RAG_AUDIT_RETENTION_DAYS=30
RAG_SECURE_EXPORT_ENABLED=true
RAG_INDEX_ROOT=
RAG_INDEX_RETENTION_COUNT=2
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_MAX=3
RAG_DEFAULT_AS_OF_TIME=
RAG_DEFAULT_RETRIEVAL_MODE=bm25-first-semantic-hybrid
AGENT_LLM_PROVIDER=rule

# v2.0 Agent-RAG Phase 3A optional real dense retrieval.
# Keep model weights and generated FAISS indexes outside Git.
RAG_DENSE_PROVIDER=hash
RAG_BGE_M3_PROVIDER_IMPL=flagembedding
RAG_BGE_M3_MODEL_PATH=
RAG_BGE_M3_DEVICE=cpu
RAG_BGE_M3_USE_FP16=false
RAG_BGE_M3_BATCH_SIZE=8
RAG_BGE_M3_MAX_LENGTH=512
RAG_BGE_M3_NORMALIZE=true
RAG_BGE_M3_LOAD_ON_STARTUP=false
RAG_DENSE_FALLBACK_PROVIDER=hash
RAG_FAISS_INDEX_TYPE=flat
RAG_FAISS_METRIC=inner-product
RAG_FAISS_SEARCH_TOP_K=20
RAG_REAL_DENSE_REQUIRED=false

# v2.5 Agentic review workflow + public policy RAG.
# Use ai-service/.venv and keep Qwen weights outside Git.
E_REVIEW_AGENTIC_WORKFLOW_ENABLED=true
E_REVIEW_AGENTIC_MAX_ITERATIONS=2
E_REVIEW_AGENTIC_MEMORY_ENABLED=true
E_REVIEW_AGENTIC_MEMORY_RECENT_TURNS=2
E_REVIEW_AGENTIC_MEMORY_MAX_CONTEXT_TOKENS=800
E_REVIEW_AGENTIC_CHECKPOINT_ENABLED=true
E_REVIEW_AGENTIC_CHECKPOINT_DIR=data/workflow_checkpoints

# Optional Langfuse v4 observability sidecar. Keep disabled until a local/self-host host and keys exist.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=
OTEL_SERVICE_NAME=e-review-ai-service
LANGFUSE_SAMPLE_RATE=1.0

# Step 21.2 sidecar calibration artifact. It does not change production routing.
E_REVIEW_CONFIDENCE_CALIBRATOR_PATH=data/risk_calibration/confidence_calibrator_v1.json
E_REVIEW_AGENTIC_INTENT_ROUTER_PROVIDER=rule
E_REVIEW_AGENTIC_INTENT_ROUTER_MODEL=Qwen/Qwen2.5-0.5B-Instruct
E_REVIEW_AGENTIC_INTENT_ROUTER_TIMEOUT_MS=3000
E_REVIEW_AGENTIC_ROUTER_RULE_ENHANCEMENTS_ENABLED=true
E_REVIEW_HIGH_RISK_SAFETY_GATE_ENABLED=true
# Step 21.4: observe only. Never changes the current route or executes a candidate chain.
E_REVIEW_FAST_ELIGIBILITY_SHADOW_ENABLED=false
E_REVIEW_FAST_ELIGIBILITY_SHADOW_POLICY_PATH=artifacts/step213h_fast_eligibility_gate/fast_eligibility_policy_v1.json
E_REVIEW_FAST_ELIGIBILITY_SHADOW_OUTPUT_DIR=artifacts/step214_fast_eligibility_shadow
E_REVIEW_FAST_ELIGIBILITY_SHADOW_REPORT_PATH=../docs/FAST_ELIGIBILITY_SHADOW_REPORT.md
# Step 21.5: controlled activation. Disable this single switch to restore the baseline chain.
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_ENABLED=false
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_CANARY_PERCENT=100
E_REVIEW_FAST_ELIGIBILITY_RUNTIME_POLICY_PATH=artifacts/step213h_fast_eligibility_gate/fast_eligibility_policy_v1.json
E_REVIEW_HUMAN_REVIEW_ENABLED=true
E_REVIEW_POLICY_EVIDENCE_DISPLAY_ENABLED=true
E_REVIEW_POLICY_RAG_ENABLED=true
E_REVIEW_POLICY_RAG_INDEX_PATH=data/policy_rag_real/index/policy_chunks.jsonl
E_REVIEW_POLICY_RAG_STRICT_INDEX=false
E_REVIEW_POLICY_RAG_DENSE_ENABLED=true
E_REVIEW_POLICY_RAG_DENSE_RETRIEVAL_ENABLED=true
E_REVIEW_POLICY_RAG_BM25_FALLBACK_ENABLED=true
E_REVIEW_POLICY_RAG_TOP_K=3
E_REVIEW_POLICY_RAG_EMBEDDING_PROVIDER=qwen
E_REVIEW_POLICY_RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
E_REVIEW_POLICY_RAG_EMBEDDING_MODEL_PATH=
E_REVIEW_POLICY_RAG_EMBEDDING_IMPL=transformers
E_REVIEW_POLICY_RAG_EMBEDDING_DEVICE=cpu
E_REVIEW_POLICY_RAG_EMBEDDING_BATCH_SIZE=4
E_REVIEW_POLICY_RAG_EMBEDDING_MAX_LENGTH=96
E_REVIEW_POLICY_RAG_EMBEDDING_ALLOW_REMOTE=false
E_REVIEW_POLICY_RAG_EMBEDDING_MAX_CONCURRENCY=1
E_REVIEW_POLICY_RAG_EMBEDDING_QUEUE_TIMEOUT_MS=30000
E_REVIEW_POLICY_RAG_QUERY_CACHE_ENABLED=true
E_REVIEW_POLICY_RAG_QUERY_CACHE_TTL_SECONDS=300
E_REVIEW_POLICY_RAG_CPU_THREADS=0
E_REVIEW_POLICY_RAG_WARMUP_ENABLED=false
E_REVIEW_POLICY_RAG_VECTOR_STORE=faiss
# Step 23.3F: strict-path Top5 BGE reranking. Keep local weights outside Git.
E_REVIEW_POLICY_RAG_RERANKER_ENABLED=false
E_REVIEW_POLICY_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
E_REVIEW_POLICY_RAG_RERANKER_MODEL_PATH=<your-local-reranker-path>
E_REVIEW_POLICY_RAG_RERANKER_DEVICE=cpu
E_REVIEW_POLICY_RAG_RERANKER_BATCH_SIZE=5
E_REVIEW_POLICY_RAG_RERANKER_CANDIDATE_K=5
E_REVIEW_POLICY_RAG_RERANKER_FINAL_K=3
E_REVIEW_POLICY_RAG_RERANKER_LATENCY_BUDGET_MS=2500
E_REVIEW_POLICY_RAG_RERANKER_MAX_CONCURRENCY=1
E_REVIEW_POLICY_RAG_RERANKER_QUEUE_TIMEOUT_MS=1000
E_REVIEW_POLICY_RAG_RERANKER_WARMUP_ENABLED=false
MINERU_CLI=mineru
MINERU_OUTPUT_DIR=
MINERU_TIMEOUT_SECONDS=120
# Optional override. On Windows this directory must resolve to an ASCII-only path.
E_REVIEW_DOCUMENT_WORKER_ROOT=
E_REVIEW_DOCUMENT_LIGHT_WORKERS=4
E_REVIEW_DOCUMENT_HEAVY_WORKERS=1
E_REVIEW_POLICY_RAG_MANAGED_INDEX_ROOT=../storage/document-library/policy-index

# Optional multilingual input gate. Reuse Qwen embeddings and keep guard weights outside Git.
E_REVIEW_INPUT_GATE_SEMANTIC_ENABLED=false
E_REVIEW_INPUT_GATE_GUARD_ENABLED=false
E_REVIEW_INPUT_GATE_GUARD_MODEL_PATH=<your-local-duoguard-path>
E_REVIEW_INPUT_GATE_GUARD_DEVICE=cpu
E_REVIEW_INPUT_GATE_GUARD_THRESHOLD=0.5

# v1.6.1 local VLM provider. Keep VLM weights and real images outside Git.
E_REVIEW_VLM_PROVIDER=local_qwen3_vl_transformers
E_REVIEW_VLM_MODEL_DIR=
E_REVIEW_VLM_DEVICE=cuda
E_REVIEW_VLM_DTYPE=auto
E_REVIEW_VLM_LOAD_IN_4BIT=true
E_REVIEW_VLM_MAX_NEW_TOKENS=512
E_REVIEW_VLM_MAX_IMAGES=4
E_REVIEW_VLM_MAX_PIXELS=1048576
E_REVIEW_VLM_TIMEOUT_SECONDS=180
E_REVIEW_VLM_ENABLE_THINKING=false
E_REVIEW_VLM_MEMORY_STRATEGY=serial_lazy_load
