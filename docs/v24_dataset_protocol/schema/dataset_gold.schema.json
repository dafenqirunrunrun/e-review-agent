{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ereview.local/schema/dataset_gold.schema.json",
  "title": "E-Review Gold Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sampleId",
    "datasetVersion",
    "protocolVersion",
    "sourceAnnotationIds",
    "finalGold",
    "adjudicationStatus",
    "changeHistory",
    "sealed",
    "recordHash"
  ],
  "properties": {
    "sampleId": {
      "type": "string"
    },
    "datasetVersion": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "sourceAnnotationIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "finalGold": {
      "$ref": "dataset_annotation.schema.json"
    },
    "adjudicationStatus": {
      "enum": [
        "NOT_REQUIRED",
        "RESOLVED"
      ]
    },
    "adjudicationRecordId": {
      "type": [
        "string",
        "null"
      ]
    },
    "changeHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "actorId",
          "changeType",
          "reason"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": "string"
          },
          "changeType": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "previousHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "newHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "sealed": {
      "type": "boolean"
    },
    "sealedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "recordHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
