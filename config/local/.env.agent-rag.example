# E-Review Agent v2.0 local example configuration.
# Copy to a private location such as %LOCALAPPDATA%\EReviewAgent\.env.agent-rag.
# Do not commit a populated environment file.

E_REVIEW_RUNTIME_HOME=%LOCALAPPDATA%\EReviewAgent\runtime

# Service ports.
E_REVIEW_AI_PORT=8008
E_REVIEW_ADMIN_API_PORT=8083
E_REVIEW_ADMIN_UI_PORT=9527

# Java Admin API.
E_REVIEW_ADMIN_JAR=litemall-admin-api\target\litemall-admin-api-0.1.0-exec.jar

# Python AI runtime.
E_REVIEW_PYTHON=python
AGENT_RAG_ENABLED=true
AGENT_RAG_TARGET_MODE=enterprise-maturity-local-single-node
AGENT_RAG_RUNTIME_MODE=local-model
AGENT_LLM_PROVIDER=rule

# Optional local dense retrieval assets. Keep model weights and FAISS indexes outside Git.
RAG_DENSE_PROVIDER=hash
RAG_BGE_M3_PROVIDER_IMPL=flagembedding
RAG_BGE_M3_MODEL_PATH=
RAG_BGE_M3_DEVICE=cpu
RAG_REAL_DENSE_REQUIRED=false
RAG_INDEX_ROOT=

# Optional reranker. Unverified by default.
RAG_RERANKER_TYPE=deterministic
RAG_RERANKER_MODEL_PATH=
RAG_REAL_RERANKER_REQUIRED=false

# Optional local LLM. Unverified quality by default.
AGENT_LLM_MODEL_PATH=
AGENT_LLM_DEVICE=cpu
AGENT_LLM_REAL_QUALITY_REQUIRED=false

# Admin smoke credentials for local demo accounts only.
LITEMALL_ADMIN_USERNAME=admin123
LITEMALL_ADMIN_PASSWORD=

# Database. Prefer using MYSQL_PWD in the shell instead of writing passwords here.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=litemall
MYSQL_USER=litemall
MYSQL_PWD=

